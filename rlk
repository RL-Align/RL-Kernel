#!/usr/bin/env python3
"""Use the locally configured runtime, then delegate to the normal CLI."""
import os
import runpy
import sys
from pathlib import Path

root = Path(__file__).resolve().parent
# Load the standard-library-only CLI without importing rl_engine (and torch)
# before selecting the runtime. Reuse its parser and profile precedence rules.
cli = runpy.run_path(str(root / "rl_engine/repro.py"))
args = cli["build_parser"]().parse_args()
try:
    config, profile = cli["_load_profile"](args.profile)
except (OSError, cli["ReproError"]) as exc:
    print(f"rlk-repro: {exc}", file=sys.stderr)
    raise SystemExit(2)

python = config.get("paths", {}).get("python") or sys.executable
os.environ["RLK_REPRO_PROFILE"] = str(profile)
if config.get("ray_address"):
    os.environ.setdefault("RAY_API_SERVER_ADDRESS", config["ray_address"])
extras = [str(root)] + [
    str(config.get("paths", {}).get(k) or "")
    for k in ("runtime_site", "cuda_python_site", "te_root")
]
extras.append(os.environ.get("PYTHONPATH", ""))
os.environ["PYTHONPATH"] = os.pathsep.join(p for p in extras if p)
os.execv(python, [python, str(root / "rl_engine/repro.py"), *sys.argv[1:]])
