+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 RL-Kernel Contributors
+"""Diagnostic fixed-ID route binding; numerical work reuses task 29/30/32."""
+
+import torch
+
+from aiter.ops.triton.moe.moe_routing.hash_route import hash_route_bwd, hash_route_fwd
+from aiter.ops.triton.moe.moe_routing.learned_route import (
+    learned_route_bwd,
+    learned_route_weights,
+)
+from aiter.ops.triton.moe.moe_routing.router_sqrt_softplus import (
+    router_sqrt_softplus_fwd,
+)
+
+ROUTER_REPLAY_CONTRACT_ID = "aiter.router_replay.fixed_ids.diagnostic.v1"
+
+
+def router_replay_fwd(logits, columns, keep, kind, renormalize, scale):
+    if kind == "hash":
+        if not logits.shape[0]:
+            return torch.empty_like(columns, dtype=torch.float32), None
+        # The saved six IDs form one table row per logical token. The original
+        # Hash kernel owns score evaluation, slot-order normalization and scale.
+        weights, _ = hash_route_fwd(
+            logits,
+            columns.to(torch.int32),
+            torch.arange(logits.shape[0], device=logits.device, dtype=torch.int32),
+            renormalize,
+            scale,
+        )
+        return weights, None
+    scores = router_sqrt_softplus_fwd(logits)
+    weights, _ = learned_route_weights(scores, columns, keep, scale)
+    return weights, scores
+
+
+def router_replay_bwd(logits, scores, columns, keep, grad, kind, renormalize, scale):
+    if kind == "hash":
+        return hash_route_bwd(logits, columns, grad, renormalize, scale)
+    return learned_route_bwd(logits, scores, columns, keep, grad, scale)
