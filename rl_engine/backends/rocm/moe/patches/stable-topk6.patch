+# SPDX-License-Identifier: MIT
+# Copyright (C) 2024-2026, Advanced Micro Devices, Inc. All rights reserved.
+# Modifications Copyright (c) 2026 RL-Kernel Contributors
+"""Adapt AITER streaming_topk to score-descending/global-ID-ascending slots.
+
+Raw FP32 payloads are loaded unchanged after ranking. Signed zeros tie, while
+all other finite bit patterns (including subnormals) keep their numeric order.
+"""
+
+import triton
+import triton.language as tl
+
+from aiter.ops.triton._triton_kernels.moe.moe_routing.topk import fpval_to_key
+
+
+@triton.jit
+def _pack_keys(value, gid, column, valid):
+    raw = value.to(tl.uint32, bitcast=True)
+    # Canonicalize zeros for ranking only; return the original payload below.
+    ranking_bits = tl.where((raw & 0x7FFFFFFF) == 0, 0, raw).to(tl.uint32)
+    score_key = fpval_to_key(ranking_bits)
+    packed = (
+        (score_key.to(tl.uint64) << 32)
+        | ((65535 - gid.to(tl.uint64)) << 16)
+        | column.to(tl.uint64)
+    )
+    return tl.where(valid, packed, 0)
+
+
+@triton.jit
+def streaming_stable_topk6(X, GIDS, row, EXPERTS: tl.constexpr, BLOCK_N: tl.constexpr):
+    # Same peeled-last-block and bitonic streaming merge as upstream AITER.
+    chunks: tl.constexpr = tl.cdiv(EXPERTS, BLOCK_N)
+    column = (chunks - 1) * BLOCK_N + tl.arange(0, BLOCK_N)
+    valid = column < EXPERTS
+    value = tl.load(X + row * EXPERTS + column, mask=valid, other=0.0)
+    gid = tl.load(GIDS + column, mask=valid, other=0)
+    key = _pack_keys(value, gid, column, valid)
+    candidates = tl.topk(key[None, :], 8, dim=1)
+    for _ in (tl.static_range if chunks <= 4 else range)(chunks - 1):
+        candidates = tl.bitonic_merge(candidates)
+        column -= BLOCK_N
+        value = tl.load(X + row * EXPERTS + column)
+        gid = tl.load(GIDS + column)
+        key = _pack_keys(value, gid, column, tl.full((BLOCK_N,), True, tl.int1))
+        candidates = tl.maximum(candidates, tl.topk(key[None, :], 8, dim=1))
+    # K=6 is padded to 8, so sort merged candidates before keeping slots 0..5.
+    return tl.sort(candidates, descending=True, dim=1)
+
+
+@triton.jit
+def _stable_topk6_fwd(X, GIDS, VALUES, IDS, COLUMNS, EXPERTS: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    candidates = streaming_stable_topk6(X, GIDS, row, EXPERTS, 128)
+    column = (candidates & 65535).to(tl.int32)
+    gid = (65535 - ((candidates >> 16) & 65535)).to(tl.int64)
+    slot = tl.arange(0, 8)[None, :]
+    # Keep signed-zero/subnormal payload bytes, rather than decoding the key.
+    value = tl.load(X + row * EXPERTS + column, mask=slot < 6, other=0.0)
+    tl.store(VALUES + row * 6 + slot, value, mask=slot < 6)
+    tl.store(IDS + row * 6 + slot, gid, mask=slot < 6)
+    tl.store(COLUMNS + row * 6 + slot, column, mask=slot < 6)
+
+
+@triton.jit
+def _stable_topk6_vjp(COLUMNS, GRAD, DX, EXPERTS: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    slot = tl.arange(0, 8)
+    column = tl.load(COLUMNS + row * 6 + slot, mask=slot < 6, other=0)
+    grad = tl.load(GRAD + row * 6 + slot, mask=slot < 6, other=0.0)
+    # Unique columns imply one writer per output; no atomics or reductions.
+    tl.store(DX + row * EXPERTS + column, grad, mask=slot < 6)
