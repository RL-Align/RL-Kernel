+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 RL-Kernel Contributors
+"""Task-31 stable selection over already computed FP32 selection scores."""
+
+import torch
+
+from aiter.ops.triton._triton_kernels.moe.moe_routing.stable_topk6 import (
+    _stable_topk6_fwd,
+    _stable_topk6_vjp,
+)
+
+STABLE_TOPK6_CONTRACT_ID = "aiter.stable_topk6.fp32.global_id.v1"
+LAUNCH = {"num_warps": 4, "num_stages": 1, "enable_fp_fusion": False}
+
+
+def stable_topk6_fwd(scores, global_expert_ids):
+    m = scores.shape[0]
+    values = torch.empty((m, 6), dtype=torch.float32, device=scores.device)
+    ids = torch.empty((m, 6), dtype=torch.int64, device=scores.device)
+    columns = torch.empty((m, 6), dtype=torch.int32, device=scores.device)
+    if m:
+        _stable_topk6_fwd[(m,)](
+            scores,
+            global_expert_ids,
+            values,
+            ids,
+            columns,
+            EXPERTS=scores.shape[1],
+            **LAUNCH,
+        )
+    return values, ids, columns
+
+
+def stable_topk6_bwd(columns, grad_values, experts):
+    grad = grad_values.contiguous()
+    dx = torch.zeros(
+        (columns.shape[0], experts), dtype=torch.float32, device=columns.device
+    )
+    if columns.shape[0]:
+        _stable_topk6_vjp[(columns.shape[0],)](
+            columns, grad, dx, EXPERTS=experts, **LAUNCH
+        )
+    return dx
