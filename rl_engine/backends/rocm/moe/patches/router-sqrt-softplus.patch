 @triton.jit
+def _sqrt_softplus_fp32(x):
+    # log1p preserves negative-tail scores that log(1 + exp(x)) rounds to zero.
+    # Below -16 the relative error of exp(x/2) is at most exp(-16)/4;
+    # this branch also avoids underflow in exp(x) before taking the square root.
+    x_f = x.to(tl.float32)
+    sp = tl.maximum(x_f, 0.0) + libdevice.log1p(libdevice.exp(-tl.abs(x_f)))
+    tail = libdevice.exp(0.5 * tl.minimum(x_f, 0.0))
+    return tl.where(x_f < -16.0, tail, tl.sqrt(sp))
+
