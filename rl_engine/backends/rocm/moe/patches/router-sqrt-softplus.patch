+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 RL-Kernel Contributors
+"""Standalone FP32 sqrt-softplus and its first-order VJP for DSV4 task 29.
+
+The caller validates finite FP32 [M,E] inputs on the same device. Both paths
+use fixed elementwise programs; neither selection nor normalization is fused.
+"""
+
+import torch
+import triton
+import triton.language as tl
+import triton.language.extra.libdevice as libdevice
+
+from aiter.ops.triton._triton_kernels.moe.moe_routing.topk import _apply_score_mode
+
+ROUTER_SQRT_SOFTPLUS_CONTRACT_ID = "aiter.router_sqrt_softplus.fp32.stable_tail.v1"
+BLOCK = 256
+LAUNCH = {"num_warps": 4, "num_stages": 1, "enable_fp_fusion": False}
+
+
+@triton.jit
+def _router_sqrt_softplus_fwd(
+    X,
+    Y,
+    SIZE,
+    COLS: tl.constexpr,
+    STRIDE_M: tl.constexpr,
+    STRIDE_E: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    i = tl.program_id(0).to(tl.int64) * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    x = tl.load(
+        X + (i // COLS) * STRIDE_M + (i % COLS) * STRIDE_E, mask=i < SIZE, other=0.0
+    )
+    y = _apply_score_mode(x, "sqrtsoftplus")
+    tl.store(Y + i, y, mask=i < SIZE)
+
+
+@triton.jit
+def _router_sqrt_softplus_bwd(
+    X,
+    Y,
+    DY,
+    DX,
+    SIZE,
+    COLS: tl.constexpr,
+    STRIDE_M: tl.constexpr,
+    STRIDE_E: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    i = tl.program_id(0).to(tl.int64) * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    x = tl.load(
+        X + (i // COLS) * STRIDE_M + (i % COLS) * STRIDE_E, mask=i < SIZE, other=0.0
+    )
+    y = tl.load(Y + i, mask=i < SIZE, other=1.0)
+    dy = tl.load(DY + i, mask=i < SIZE, other=0.0)
+    e = libdevice.exp(-tl.abs(x))
+    sigmoid = tl.where(x >= 0.0, 1.0 / (1.0 + e), e / (1.0 + e))
+    # Do not form 0/0 in the negative tail. Multiply the completed slope by
+    # the FP32 upstream gradient last, with FP fusion disabled.
+    safe_y = tl.where(x < -16.0, 1.0, y)
+    regular_slope = sigmoid / (2.0 * safe_y)
+    slope = tl.where(x < -16.0, 0.5 * y, regular_slope)
+    ordinary_vjp = dy * slope
+    # A subnormal/zero FP32 score must not erase a representable VJP when
+    # multiplied by a large finite upstream gradient. Rescale in log space
+    # in the deep tail; log(0)=-inf gives a signed zero contribution.
+    tail_log = (libdevice.log(tl.abs(dy)) + 0.5 * x) - 0.6931471805599453
+    tail_vjp = libdevice.copysign(libdevice.exp(tail_log), dy)
+    vjp = tl.where(x < -160.0, tail_vjp, ordinary_vjp)
+    tl.store(DX + i, vjp, mask=i < SIZE)
+
+
+def router_sqrt_softplus_fwd(x):
+    y = torch.empty(x.shape, dtype=torch.float32, device=x.device)
+    if x.numel():
+        _router_sqrt_softplus_fwd[(triton.cdiv(x.numel(), BLOCK),)](
+            x,
+            y,
+            x.numel(),
+            x.shape[1],
+            x.stride(0),
+            x.stride(1),
+            BLOCK_SIZE=BLOCK,
+            **LAUNCH,
+        )
+    return y
+
+
+def router_sqrt_softplus_bwd(x, y, grad_output):
+    grad = grad_output.contiguous()
+    dx = torch.empty(x.shape, dtype=torch.float32, device=x.device)
+    if x.numel():
+        _router_sqrt_softplus_bwd[(triton.cdiv(x.numel(), BLOCK),)](
+            x,
+            y,
+            grad,
+            dx,
+            x.numel(),
+            x.shape[1],
+            x.stride(0),
+            x.stride(1),
+            BLOCK_SIZE=BLOCK,
+            **LAUNCH,
+        )
+    return dx
