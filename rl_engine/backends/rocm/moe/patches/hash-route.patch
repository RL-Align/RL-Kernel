+# SPDX-License-Identifier: MIT
+# Copyright (C) 2024-2026, Advanced Micro Devices, Inc. All rights reserved.
+# Modifications Copyright (c) 2026 RL-Kernel Contributors
+"""Task-30 fixed-slot Hash route binding and local first-order weight VJP."""
+
+import torch
+import triton
+import triton.language as tl
+import triton.language.extra.libdevice as libdevice
+
+from aiter.ops.triton._triton_kernels.moe.moe_routing.topk import _sqrt_softplus_fp32
+from aiter.ops.triton._triton_kernels.moe.moe_routing.hash_route import _hash_routing
+from aiter.ops.triton.moe.moe_routing.bitmatrix import Bitmatrix
+
+HASH_ROUTE_CONTRACT_ID = "aiter.hash_route.fp32.slot_order.clamp_min.v1"
+
+
+def hash_route_fwd(logits, tid2eid, token_ids, renormalize, scale):
+    # Existing hash_routing owns lookup, score transform, gather and bitmatrix.
+    weights, indices, _ = _hash_routing_impl(
+        logits,
+        tid2eid,
+        token_ids,
+        6,
+        score_mode="sqrtsoftplus",
+        renorm=renormalize,
+        routed_scaling_factor=scale,
+    )
+    return weights, indices.to(torch.int64)
+
+
+@triton.jit
+def _hash_route_vjp(
+    X, IDS, G, DX, ROWS, RENORMALIZE: tl.constexpr, SCALE: tl.constexpr
+):
+    row = tl.program_id(0).to(tl.int64)
+    slot = tl.arange(0, 8)
+    expert = tl.load(IDS + row * 6 + slot, mask=slot < 6, other=0)
+    x = tl.load(X + row * 256 + expert, mask=slot < 6, other=0.0)
+    score = tl.where(slot < 6, _sqrt_softplus_fp32(x), 0.0)
+    grad = tl.load(G + row * 6 + slot, mask=slot < 6, other=0.0) * SCALE
+    total = tl.full((), 0.0, tl.float32)
+    for i in tl.static_range(6):
+        total += tl.sum(tl.where(slot == i, score, 0.0), axis=0)
+    denominator = tl.maximum(total, 1e-20) if RENORMALIZE else 1.0
+    dot = tl.full((), 0.0, tl.float32)
+    if RENORMALIZE:
+        normalized = score / denominator
+        for i in tl.static_range(6):
+            dot += tl.sum(tl.where(slot == i, grad * normalized, 0.0), axis=0)
+    numerator = grad - tl.where(RENORMALIZE & (total >= 1e-20), dot, 0.0)
+    e = libdevice.exp(-tl.abs(x))
+    sigmoid = tl.where(x >= 0, 1.0 / (1.0 + e), e / (1.0 + e))
+    safe_score = tl.where(x < -16.0, 1.0, score)
+    regular = (numerator / denominator) * (sigmoid / (2.0 * safe_score))
+    # Combine the negative-tail slope and normalization in log space. This
+    # preserves derivatives when score=0 or numerator/denominator would overflow.
+    log_abs = (
+        (libdevice.log(tl.abs(numerator)) + 0.5 * x) - 0.6931471805599453
+    ) - libdevice.log(denominator)
+    tail = libdevice.copysign(libdevice.exp(log_abs), numerator)
+    value = tl.where(x < -16.0, tail, regular)
+    tl.store(DX + row * 256 + expert, value, mask=slot < 6)
+
+
+def hash_route_bwd(logits, indices, grad_weights, renormalize, scale):
+    # Caller guarantees six distinct expert IDs per row. No scatter atomics.
+    grad = grad_weights.contiguous()
+    dx = torch.zeros_like(logits)
+    if logits.shape[0]:
+        _hash_route_vjp[(logits.shape[0],)](
+            logits,
+            indices,
+            grad,
+            dx,
+            logits.shape[0],
+            RENORMALIZE=renormalize,
+            SCALE=scale,
+            num_warps=1,
+            num_stages=1,
+            enable_fp_fusion=False,
+        )
+    return dx
+
+
+def _hash_routing_impl(
+    router_logits: torch.Tensor,  # [n_rows, n_expts_tot] bf16/fp32
+    tid2eid: torch.Tensor,  # [vocab_size, K] int32 per-token-id expert table
+    input_ids: torch.Tensor,  # [n_rows] int32 token ids (post DP gather, clamped)
+    n_expts_act: int,
+    HIST_BLOCK_M: int = 32,
+    score_mode: str = "sqrtsoftplus",
+    renorm: bool = True,
+    routed_scaling_factor: float = 1.0,
+):
+    """Fused hash routing: tid2eid lookup + score transform + gather + renorm
+    + scale + bitmatrix construction. Output contract matches :func:`topk` so
+    downstream :func:`sort_tokens_fused` consumes it unchanged.
+
+    Replaces the Python ``_hash_topk`` + ``fused_routing_from_topk``
+    counting-sort + bitmatrix-build chain with one Triton kernel launch.
+    """
+
+    BLOCK_M = 32
+    BLOCK_N = 128
+    BLOCK_S = 128
+    BLOCK_SP = 128
+    assert router_logits.dim() == 2
+    assert input_ids.dim() == 1
+    assert tid2eid.dim() == 2
+    assert input_ids.shape[0] == router_logits.shape[0]
+    assert tid2eid.shape[1] == n_expts_act, (
+        f"tid2eid second dim {tid2eid.shape[1]} must equal n_expts_act {n_expts_act}"
+    )
+    assert tid2eid.dtype == torch.int32
+    assert input_ids.dtype in (torch.int32, torch.int64)
+    assert score_mode in ("sqrtsoftplus",)
+
+    n_rows, n_cols = router_logits.shape
+    dev = router_logits.device
+    k = n_expts_act
+
+    y_vals = torch.empty((n_rows, k), dtype=router_logits.dtype, device=dev)
+    y_indx = torch.empty((n_rows, k), dtype=torch.int16, device=dev)
+    # See note in topk(): pad to ≥ 2 to dodge tl.topk(k=1) compile bug.
+    k_pow2 = max(2, triton.next_power_of_2(k))
+
+    n_cols_pad = triton.cdiv(n_cols, BLOCK_N) * BLOCK_N
+    n_cols_words = n_cols_pad // 32
+    bitmatrix = torch.empty(
+        (n_cols_words, triton.cdiv(n_rows, 32) * 32), dtype=torch.uint32, device=dev
+    )
+    bitmatrix = torch.transpose(bitmatrix, 0, 1)[:n_rows]
+    s_blocks = triton.cdiv(n_cols, BLOCK_S)
+    s_cols = s_blocks * BLOCK_S
+    scratchpad = torch.empty((s_cols,), dtype=torch.int32, device=dev)
+    TILE_SIZE = 8
+    BLOCK_MM = HIST_BLOCK_M * TILE_SIZE
+    pids_x = triton.cdiv(n_rows, BLOCK_MM)
+    scratchpad_partials = torch.empty(
+        (n_cols_pad, pids_x * TILE_SIZE), device=dev, dtype=torch.int32
+    )
+    scratchpad_partials = torch.transpose(scratchpad_partials, 0, 1)
+    sp_size = torch.numel(scratchpad_partials)
+    sp_blocks = triton.cdiv(sp_size, BLOCK_SP)
+    pids = max(triton.cdiv(n_rows, BLOCK_M), s_blocks + sp_blocks)
+
+    # int32 cast for input_ids if int64
+    input_ids_i32 = (
+        input_ids.to(torch.int32) if input_ids.dtype != torch.int32 else input_ids
+    )
+
+    _hash_routing[(pids,)](
+        input_ids_i32,
+        tid2eid,
+        tid2eid.stride(0),
+        router_logits,
+        router_logits.stride(0),
+        y_vals,
+        y_indx,
+        y_vals.stride(0),
+        bitmatrix,
+        bitmatrix.stride(0),
+        bitmatrix.stride(1),
+        n_rows,
+        n_cols,
+        scratchpad,
+        BLOCK_S,
+        s_blocks,
+        scratchpad_partials,
+        BLOCK_SP,
+        sp_blocks,
+        sp_size,
+        BLOCK_M=BLOCK_M,
+        BLOCK_N=BLOCK_N,
+        N_EXPTS_PAD=n_cols_pad,
+        N_EXPTS_ACT=k,
+        N_EXPTS_ACT_PAD=k_pow2,
+        SCORE_MODE=score_mode,
+        APPLY_RENORM=renorm,
+        ROUTED_SCALING=routed_scaling_factor,
+        num_warps=8,
+        enable_fp_fusion=False,
+    )
+
+    bitmatrix_shape = [n_rows, n_cols_words * 32]
+    bitmatrix = Bitmatrix(
+        bitmatrix,
+        shape=bitmatrix_shape,
+        scratchpad=scratchpad,
+        scratchpad_partials=scratchpad_partials,
+    )
+    return y_vals, y_indx, bitmatrix
