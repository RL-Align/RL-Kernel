+def _fill_topp_sparse_rows(
+    sparse_ids: torch.Tensor,
+    ids: list[int],
+    offsets: list[int],
+    response_start: int,
+    local_start: int,
+    length: int,
+) -> None:
+    """Copy ragged rollout nuclei into rows of a compact padded tensor."""
+
+    end = min(response_start + length, max(len(offsets) - 1, 0))
+    for response_idx in range(response_start, end):
+        nucleus = ids[offsets[response_idx] : offsets[response_idx + 1]]
+        row = local_start + response_idx - response_start
+        if nucleus:
+            sparse_ids[row, : len(nucleus)] = torch.tensor(
+                nucleus, device=sparse_ids.device, dtype=torch.long
+            )
+
+
+def _build_topp_sparse_ids(
+    target_ids: torch.Tensor,
+    top_p_token_ids: list[list[int]],
+    top_p_token_offsets: list[list[int]],
+    total_lengths: list[int],
+    response_lengths: list[int],
+    allgather_cp: bool,
+) -> torch.Tensor:
+    """Build compact ``[T, K]`` global nucleus IDs for strict replay.
+
+    Non-response rows are initialized to their target only.  Those rows are
+    discarded by response extraction, while this avoids any full-vocabulary
+    work for them.  The strict provider canonicalizes and de-duplicates each
+    row before scoring.
+    """
+
+    normalized_ids = [t.tolist() if torch.is_tensor(t) else list(t) for t in top_p_token_ids]
+    normalized_offsets = [
+        t.tolist() if torch.is_tensor(t) else list(t) for t in top_p_token_offsets
+    ]
+    max_nucleus = max(
+        (
+            offsets[index + 1] - offsets[index]
+            for offsets in normalized_offsets
+            for index in range(max(len(offsets) - 1, 0))
+        ),
+        default=1,
+    )
+    max_nucleus = max(int(max_nucleus), 1)
+    sparse_ids = torch.full(
+        (target_ids.numel(), max_nucleus),
+        -1,
+        dtype=torch.long,
+        device="cpu",
+    )
+    sparse_ids[:, 0] = target_ids.detach().to(device="cpu", dtype=torch.long)
+
+    cp_size = mpu.get_context_parallel_world_size()
+    if cp_size > 1 and not allgather_cp:
+        local_base = 0
+        for ids, offsets, total_length, response_length in zip(
+            normalized_ids,
+            normalized_offsets,
+            total_lengths,
+            response_lengths,
+            strict=False,
+        ):
+            prompt_length = total_length - response_length
+            chunk_size_cp, chunks_offset, logits_offset, tokens_offset = get_logits_and_tokens_offset_with_cp(
+                total_length, response_length
+            )
+            for half, base in ((0, local_base), (1, local_base + chunk_size_cp)):
+                local_start = base + logits_offset[half][0] - chunks_offset[half][0]
+                length = logits_offset[half][1] - logits_offset[half][0]
+                response_start = tokens_offset[half][0] - prompt_length
+                _fill_topp_sparse_rows(
+                    sparse_ids, ids, offsets, response_start, local_start, length
+                )
+            local_base += 2 * chunk_size_cp
+        return sparse_ids.to(device=target_ids.device, non_blocking=True)
+
+    if allgather_cp:
+        cp_rank = mpu.get_context_parallel_rank()
+        local_len = target_ids.numel()
+        chunk_start = cp_rank * local_len
+        chunk_end = chunk_start + local_len
+        seq_start = 0
+        for ids, offsets, total_length, response_length in zip(
+            normalized_ids,
+            normalized_offsets,
+            total_lengths,
+            response_lengths,
+            strict=False,
+        ):
+            prompt_length = total_length - response_length
+            logit_global_start = seq_start + prompt_length - 1
+            logit_global_end = seq_start + total_length - 1
+            start = max(logit_global_start, chunk_start)
+            end = min(logit_global_end, chunk_end)
+            if end > start:
+                _fill_topp_sparse_rows(
+                    sparse_ids,
+                    ids,
+                    offsets,
+                    start - logit_global_start,
+                    start - chunk_start,
+                    end - start,
+                )
+            seq_start += total_length
+        return sparse_ids.to(device=target_ids.device, non_blocking=True)
+
+    offset = 0
+    for ids, offsets, total_length, response_length in zip(
+        normalized_ids,
+        normalized_offsets,
+        total_lengths,
+        response_lengths,
+        strict=False,
+    ):
+        end = offset + total_length
+        start = end - response_length
+        _fill_topp_sparse_rows(sparse_ids, ids, offsets, 0, start - 1, response_length)
+        offset += total_length
+    return sparse_ids.to(device=target_ids.device, non_blocking=True)
+
