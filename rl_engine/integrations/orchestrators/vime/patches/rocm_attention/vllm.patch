+def _encode_int32_array(values: list[int]) -> str:
+    buf = io.BytesIO()
+    np.save(buf, np.asarray(values, dtype=np.int32))
+    return base64.b64encode(buf.getvalue()).decode("ascii")
+
+
+def _encode_top_p_token_spans(top_logprobs) -> tuple[str, str]:
+    """Encode every finite processed-logprob token as ragged top-p spans."""
+    token_ids: list[int] = []
+    offsets = [0]
+    for position in top_logprobs:
+        if position is not None:
+            token_ids.extend(
+                int(token_id)
+                for token_id, logprob in position.items()
+                if np.isfinite(logprob.logprob)
+            )
+        offsets.append(len(token_ids))
+    return _encode_int32_array(token_ids), _encode_int32_array(offsets)
+
